# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 예시 파일은 «설정할 값의 목록» 이라 커밋한다. 실제 값은 위 규칙이 계속 막는다.
# (FITI 는 이 한 줄이 빠져서 .env.example 이 저장소에 올라가지 않았다.)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright-mcp
.playwright-mcp/

# 브라우저 검증 산출물
.playwright-mcp/
