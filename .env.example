# 세모 큐레이션 피드 — 이 쇼핑몰의 상품 출처 (src/lib/semo-feed.ts)
#
# 세모 마스터가 「이 쇼핑몰 × 품목 × 공급사」로 승인한 조합만 내려온다.
# 셋 다 서버 전용이다 — NEXT_PUBLIC_ 을 붙이면 파트너 키가 브라우저 번들로 새 나간다.

# 세모 API 베이스. 운영 https://api.semo.io.kr/api/v1 · 로컬 http://localhost:5555/api/v1
SEMO_API_BASE=https://api.semo.io.kr/api/v1

# 세모 external API 파트너 키. 이 쇼핑몰 전용이 아니라 씨마켓 연동 전체가 쓰는 키다.
SEMO_API_KEY=

# 쇼핑몰 식별자. 세모 어드민의 storefronts.slug 와 같아야 한다.
#
# `c-point` 는 세모에 **이미 등록되어 있다**(2026-08-24 확인: items/categories 둘 다 200).
# 다만 승인된 품목이 아직 0건이라 목록은 「아직 등록된 상품이 없습니다」로 뜬다 —
# 장애가 아니라 세모 쪽에서 이 몰에 품목을 승인해 주면 그대로 채워진다.
# 화면을 데이터가 있는 상태로 보고 싶으면 잠깐 `kclmro` 로 바꿔 띄운다(커밋하지 않는다).
STOREFRONT_SLUG=c-point

# ── 씨마켓 SSO (OAuth 2.0 authorization_code + PKCE) ─────────────────────
#
# 이 몰의 유일한 인증 경로다. 씨마켓(c-market.kr)과 이 몰은 별도 등록 도메인이라 쿠키를
# 공유할 수 없다 — top-level 리다이렉트로 신원을 받아 이 도메인의 first-party 세션을
# 새로 발급한다. 아래 다섯 값이 **모두** 차 있어야 로그인이 열린다. 하나라도 비면
# 운영에서는 /shop 이 닫히고(로그인 화면이 사유를 밝힌다), 로컬에서는 게이트를 통과한다.

# 씨마켓 어드민이 발급한 파트너 키. 서버 전용이다.
# 그 키에 `sso:login` 스코프와 아래 redirect_uri 가 등록되어 있어야 로그인이 열린다:
#   https://<이 몰 도메인>/api/auth/callback/cmarket   (로컬: http://localhost:3000/...)
CMARKET_CLIENT_ID=
CMARKET_CLIENT_SECRET=

# Auth.js 세션 서명 키. `openssl rand -base64 32` 로 만든다.
AUTH_SECRET=

# 배포 도메인. Auth.js 가 콜백 URL 을 만들 때 쓴다. 씨마켓에 등록한 redirect_uri 와
# 정확일치해야 한다. 로컬은 비워 둔다(Next 가 요청 호스트를 쓴다).
AUTH_URL=

# authorize 는 반드시 **테넌트 호스트**여야 한다 — 로그인 화면이 기관 브랜딩으로 뜨고,
# 씨마켓 로그인이 host 로 소속 기관을 판정한다. 예) https://kcl.c-market.kr/sso/authorize
# C-POINT 의 테넌트 호스트가 정해지면 채운다. 기본값은 두지 않았다(남의 몰 화면이 뜬다).
CMARKET_AUTHORIZE_URL=

# 토큰 교환·신원 조회는 **파트너 API** 다. app-api.c-market.net 은 씨마켓 내부 전용이라
# 이 몰의 자격증명으로는 401 이고, api.c-market.net 은 V5 어댑터라 404 다. 평소엔 비워 둔다.
CMARKET_API_BASE=https://partner-api.c-market.net

# (선택) 이 몰이 **추가로** 좁히는 기관 그룹(씨마켓 b2b_member.group_code). 쉼표로 여러 개.
#
# 평소엔 비워 둔다. 입장 자격의 정본은 씨마켓 어드민(파트너 키 > SSO 클라이언트 > 허용 기관)이고,
# 몰이 같은 목록을 또 들고 있으면 기관을 추가할 때마다 두 곳을 고쳐야 한다 — 한쪽만 고치면
# 어긋난 채로 조용히 지나간다. 씨마켓 등록이 잘못 넓어져도 이 몰만은 막고 싶을 때만 채운다.
CMARKET_GROUP_CODES=
